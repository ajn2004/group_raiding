{
  "name": "group-raiding",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "lint": "pnpm web:lint",
    "typecheck": "pnpm web:typecheck",
    "test": "pnpm web:test",
    "build": "pnpm web:build",
    "backend:sync": "cd apps/backend && uv sync",
    "backend:test": "cd apps/backend && uv run pytest",
    "backend:bot": "cd apps/backend && uv run python main.py",
    "backend:api": "cd apps/backend && uv run uvicorn app.api.main:app --reload",
    "backend:openapi": "cd apps/backend && uv run python scripts/export_openapi.py",
    "web:generate-api": "pnpm --filter @group-raiding/web generate:api",
    "backend:alembic": "cd apps/backend && uv run alembic",
    "web:lint": "pnpm --filter @group-raiding/web lint",
    "web:typecheck": "pnpm --filter @group-raiding/web typecheck",
    "web:dev": "pnpm --filter @group-raiding/web dev",
    "web:test": "pnpm --filter @group-raiding/web test",
    "web:build": "pnpm --filter @group-raiding/web build"
  }
}
