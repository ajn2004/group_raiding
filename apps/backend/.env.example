# Backend environment
# Copy this file to .env in apps/backend and replace only values needed for your workflow.

# Python / Discord bot (required only when running the live bot)
DISCORD_BOT_TOKEN='YOUR_DISCORD_BOT_API_TOKEN'

# Required only to fetch or snapshot Warcraft Logs data (saved replay is offline)
WCL_CLIENT_ID='YOUR_WARCRAFT_LOGS_CLIENT_ID'
WCL_CLIENT_SECRET='YOUR_WARCRAFT_LOGS_CLIENT_SECRET'

# Preferred live Pull Coach mechanics root. Blank means unset; only verified/*.json is analyzer input.
PULL_COACH_MECHANICS_ROOT=''
# Compatibility-only fallback for the former single-file configuration.
# PULL_COACH_MECHANICS_FILE='/path/to/verified-mechanics.json'

# Python / legacy bot database configuration
SQLALCHEMY_DATABASE_USER='YOUR_USER_NAME'
SQLALCHEMY_DATABASE_PASSWORD='YOUR_PASSWORD'
SQLALCHEMY_DATABASE_HOST='YOUR_DATABASE_ADDR'
SQLALCHEMY_DATABASE_PORT='YOUR_DATABASE_PORT'
SQLALCHEMY_DATABASE_DB='YOUR_DATABASE_NAME'

# Web Discord OAuth (browser URLs use the same-origin Next.js /api proxy)
DISCORD_OAUTH_CLIENT_ID='YOUR_DISCORD_OAUTH_APPLICATION_CLIENT_ID'
DISCORD_OAUTH_CLIENT_SECRET='YOUR_DISCORD_OAUTH_APPLICATION_CLIENT_SECRET'
PUBLIC_APP_URL='http://localhost:3000'
DISCORD_OAUTH_CALLBACK_URL='http://localhost:3000/api/auth/discord/callback'
DISCORD_GUILD_ID='YOUR_DISCORD_COMMUNITY_ID'
# Durable server-side sessions and one-use OAuth state. Mount this file path on a persistent volume in production.
AUTH_SESSION_DATABASE='./data/auth_sessions.sqlite3'
