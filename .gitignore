# Runtime-generated Pull Coach lifecycle artifacts may contain private data.
# Keep the lanes themselves in the repository, but not their contents.
/apps/backend/mechanics/pull-coach/discovered/*
!/apps/backend/mechanics/pull-coach/discovered/.gitkeep
/apps/backend/mechanics/pull-coach/drafts/*
!/apps/backend/mechanics/pull-coach/drafts/.gitkeep
/apps/backend/mechanics/pull-coach/reviews/*
!/apps/backend/mechanics/pull-coach/reviews/.gitkeep
