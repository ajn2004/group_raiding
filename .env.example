# Required to run the legacy/live Discord bot
DISCORD_BOT_TOKEN='YOUR_DISCORD_BOT_API_TOKEN'

# Required only to fetch or snapshot Warcraft Logs data (saved replay is offline)
WCL_CLIENT_ID='YOUR_WARCRAFT_LOGS_CLIENT_ID'
WCL_CLIENT_SECRET='YOUR_WARCRAFT_LOGS_CLIENT_SECRET'

# Preferred live Pull Coach mechanics root. Only verified/*.json is analyzer input.
# Uncomment and configure to use the directory-backed registry.
# PULL_COACH_MECHANICS_ROOT='PATH_TO_PULL_COACH_MECHANICS_DIRECTORY'
# Temporary backwards-compatible fallback; used unless MECHANICS_ROOT is configured.
PULL_COACH_MECHANICS_FILE='PATH_TO_CONFIGURED_PULL_COACH_MECHANICS_JSON'

# Legacy bot database configuration
SQLALCHEMY_DATABASE_USER='YOUR_USER_NAME'
SQLALCHEMY_DATABASE_PASSWORD='YOUR_PASSWORD'
SQLALCHEMY_DATABASE_HOST='YOUR_DATABASE_ADDR'
SQLALCHEMY_DATABASE_PORT='YOUR_DATABASE_PORT'
SQLALCHEMY_DATABASE_DB='YOUR_DATABASE_NAME'
